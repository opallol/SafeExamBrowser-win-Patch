<Window x:Class="SafeExamBrowser.UserInterface.Mobile.Windows.CameraSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Camera" Height="320" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Margin="0,0,0,12" TextWrapping="Wrap"
		           Text="Please select the camera to use for proctoring during this exam session." />

		<ListBox x:Name="CameraListBox" Grid.Row="1" DisplayMemberPath="Name"
		         SelectionChanged="CameraListBox_SelectionChanged" />

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button x:Name="OkButton" Content="OK" Width="90" Height="28" Margin="0,0,8,0"
			        IsDefault="True" Click="OkButton_Click" />
			<Button x:Name="CancelButton" Content="Cancel" Width="90" Height="28"
			        IsCancel="True" Click="CancelButton_Click" />
		</StackPanel>
	</Grid>
</Window>
